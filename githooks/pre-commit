#!/usr/bin/env bash
set -euo pipefail

branch="$(git rev-parse --abbrev-ref HEAD)"
if [[ "$branch" == "main" || "$branch" == "master" ]]; then
  if [[ "${ALLOW_MAIN_COMMIT:-}" != "1" ]]; then
    echo "pre-commit: commits to $branch are blocked (set ALLOW_MAIN_COMMIT=1 to override intentionally)."
    exit 1
  fi
fi

mkdir -p tmp/hook_logs
log_file="tmp/hook_logs/pre-commit.log"

run_ruff() {
  if command -v ruff >/dev/null 2>&1; then
    ruff "$@"
    return
  fi
  if [[ -x "${HOME}/miniconda3/envs/py314_bayesmm/bin/ruff" ]]; then
    "${HOME}/miniconda3/envs/py314_bayesmm/bin/ruff" "$@"
    return
  fi
  echo "pre-commit: ruff not found in PATH and fallback env is unavailable."
  return 127
}

run_pytest() {
  if command -v pytest >/dev/null 2>&1; then
    pytest "$@"
    return
  fi
  if [[ -x "${HOME}/miniconda3/envs/py314_bayesmm/bin/pytest" ]]; then
    "${HOME}/miniconda3/envs/py314_bayesmm/bin/pytest" "$@"
    return
  fi
  echo "pre-commit: pytest not found in PATH and fallback env is unavailable."
  return 127
}

{
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] pre-commit start"

  # `--check`, NOT an in-place `ruff format .`.
  #
  # Formatting in place here rewrites files AFTER they were staged, so the commit
  # keeps the unformatted content while the working tree quietly holds the fix.
  # That is not hypothetical: it shipped an unformatted `meta/joint_sampling.py`
  # and `cli/main.py`, CI's `ruff format --check src tests` went red on all three
  # OSes, and the working-tree fix looked like an unexplained local edit and was
  # reverted. Refusing to commit and telling the author to run `make fmt` keeps
  # what is committed and what was checked as the same bytes.
  if ! run_ruff format --check .; then
    echo
    echo "pre-commit: files need formatting. Run 'make fmt', re-stage, and commit again."
    echo "            (this hook does NOT format in place: that would leave the staged"
    echo "             content unformatted while the working tree looked fine)"
    exit 1
  fi
  run_ruff check .
  run_pytest -q -m "not slow"

  changed_staged="$(git diff --cached --name-only || true)"
  # POSIX grep, not rg: hooks run non-interactively, so shell functions and
  # user PATH additions are absent. A missing tool here fails open (127 inside
  # an `if` condition is just "false"), which silently disabled this gate.
  if echo "$changed_staged" | grep -qE '^(src/|examples/)'; then
    if ! echo "$changed_staged" | grep -qE '^Status\.md$'; then
      echo "pre-commit: Status.md must be staged when src/ or examples/ changes."
      exit 1
    fi
  fi

  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] pre-commit success"
} >"$log_file" 2>&1
