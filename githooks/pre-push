#!/usr/bin/env bash
set -euo pipefail

mkdir -p tmp/hook_logs
log_file="tmp/hook_logs/pre-push.log"

run_pytest() {
  if command -v pytest >/dev/null 2>&1; then
    pytest "$@"
    return
  fi
  if [[ -x "${HOME}/miniconda3/envs/py314_metamodeling/bin/pytest" ]]; then
    "${HOME}/miniconda3/envs/py314_metamodeling/bin/pytest" "$@"
    return
  fi
  echo "pre-push: pytest not found in PATH and fallback env is unavailable."
  return 127
}

{
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] pre-push start"
  run_pytest -q -m "not slow"
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] pre-push success"
} >"$log_file" 2>&1
