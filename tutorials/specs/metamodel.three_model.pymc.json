{
  "schema_version": "1.0",
  "name": "tutorial_three_model_coupling",
  "ppl_backend": "pymc",
  "surrogate_refs": [
    "examples/coupled/artifacts/surrogate_A.artifact.json",
    "examples/coupled/artifacts/surrogate_B.artifact.json",
    "tutorials/artifacts/surrogate_C.artifact.json"
  ],
  "variables": [
    { "name": "x", "type": "scalar" },
    { "name": "y", "type": "scalar" },
    { "name": "z", "type": "scalar" },
    { "name": "C", "type": "scalar" },
    { "name": "w", "type": "scalar" }
  ],
  "couplings": [
    {
      "kind": "gaussian_link",
      "source": "y",
      "target": "C",
      "transform": { "kind": "identity" },
      "sigma": 0.2
    },
    {
      "kind": "deterministic",
      "source": "C",
      "target": "z",
      "transform": { "kind": "affine", "alpha": 1.0, "beta": 0.0 }
    },
    {
      "kind": "gaussian_link",
      "source": "z",
      "target": "w",
      "transform": { "kind": "identity" },
      "sigma": 0.25
    }
  ],
  "priors": [
    { "variable": "x", "distribution": { "kind": "normal", "loc": 0.0, "scale": 1.0 } },
    { "variable": "y", "distribution": { "kind": "normal", "loc": 0.0, "scale": 1.0 } }
  ]
}
